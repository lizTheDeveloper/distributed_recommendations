{
  "name": "@match-feed/taste",
  "version": "0.1.0",
  "description": "Publish a creator's public video picks for Match Feed's Follow taste: NIP-51 video curation sets (kind 30005) over bridged NIP-71 videos, and taste-list v1 JSON. Parsers and validators for both.",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.6"
  },
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node-signers.ts"
  },
  "bin": {
    "match-feed-taste": "./src/cli.ts"
  },
  "scripts": {
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test --test-reporter=spec test/*.test.ts",
    "cli": "NODE_USE_ENV_PROXY=1 node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=UNDICI-EHPA src/cli.ts",
    "typecheck": "../bridge/node_modules/.bin/tsc -p ."
  },
  "dependencies": {
    "nostr-tools": "2.25.2"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
