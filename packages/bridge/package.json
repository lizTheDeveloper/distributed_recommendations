{
  "name": "@match-feed/bridge",
  "version": "0.1.0",
  "description": "PeerTube -> Nostr NIP-71 video event bridge for Match Feed",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.6"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "match-feed-bridge": "./src/cli.ts"
  },
  "scripts": {
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test --test-reporter=spec test/*.test.ts",
    "sync": "NODE_USE_ENV_PROXY=1 node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=UNDICI-EHPA src/cli.ts",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "nostr-tools": "2.25.2"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
