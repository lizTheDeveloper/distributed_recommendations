{
  "name": "@match-feed/analytics",
  "version": "0.1.0",
  "description": "Tier 2 private creator analytics (how people found you): DAP/Prio3 discovery-channel reports built on the viewer's device",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.6"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test --test-reporter=spec test/*.test.ts",
    "test:e2e": "ANALYTICS_E2E=1 node --experimental-strip-types --disable-warning=ExperimentalWarning --test --test-reporter=spec test/e2e.test.ts",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@divviup/dap": "0.9.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
