{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": [],
    "baseUrl": ".",
    "paths": {
      "nostr-tools": [
        "./node_modules/nostr-tools/lib/types/index.d.ts"
      ],
      "nostr-tools/*": [
        "./node_modules/nostr-tools/lib/types/*.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ]
}
