{
  "name": "@match-feed/web",
  "version": "0.1.0",
  "description": "Meme Video web client (follow, taste lists, recipes, Reels, Match, on-device ranking over live PeerTube data).",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": "22.22.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:artifact": "node scripts/build.mjs --artifact-only",
    "dev": "node scripts/build.mjs --dev",
    "snapshot": "NODE_USE_ENV_PROXY=1 node scripts/fetch-snapshot.mjs",
    "test": "node --import ./test/deps-hook.mjs --experimental-strip-types --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "typecheck": "node scripts/typecheck.mjs",
    "dev-relay": "node scripts/dev-relay.mjs",
    "check:telemetry": "node scripts/telemetry-check.mjs"
  },
  "devDependencies": {
    "@openmined/psi.js": "2.0.6",
    "@sentry/browser": "10.76.0",
    "axe-core": "4.13.0",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.5",
    "nostr-tools": "2.25.2",
    "playwright": "1.56.1",
    "typescript": "5.9.3",
    "ws": "8.21.3"
  }
}
