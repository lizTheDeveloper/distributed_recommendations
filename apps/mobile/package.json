{
  "name": "@match-feed/mobile",
  "version": "0.1.0",
  "description": "Android and iOS shells (Capacitor) around the Match Feed web client, shipped as Meme Video.",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "sync-web": "node scripts/sync-web.mjs",
    "build:bridge": "node scripts/build-bridge.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "prepare-www": "npm run -s sync-web && npm run -s build:bridge",
    "sync": "npm run -s prepare-www && cap sync",
    "android:debug": "npm run -s sync && node scripts/android-debug.mjs",
    "ios:open": "npm run -s sync && cap open ios",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "apply-brand": "node scripts/apply-brand.mjs"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/local-notifications": "8.3.1",
    "@capgo/capacitor-share-target": "8.0.54",
    "@transistorsoft/capacitor-background-fetch": "8.1.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
