{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Meme Video",
  "version": "0.1.0",
  "identifier": "school.multiverse.memevideo",
  "build": {
    "frontendDist": "../www"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self'",
        "img-src": "'self' https: data:",
        "connect-src": "'self' ipc: http://ipc.localhost https: wss: ws://localhost:* ws://127.0.0.1:*",
        "frame-src": "'self' https:",
        "media-src": "https:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "freezePrototype": true,
      "assetProtocol": {
        "enable": false
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "dmg",
      "app",
      "msi",
      "nsis"
    ],
    "createUpdaterArtifacts": false,
    "publisher": "The Multiverse School",
    "license": "Apache-2.0",
    "category": "Video",
    "shortDescription": "Federated video, ranked on your device",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-libav"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {}
}
