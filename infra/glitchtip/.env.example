# Copy to .env and edit. .env is gitignored.

# Public hostname. DNS must point here before `docker compose up`.
GLITCHTIP_DOMAIN=errors.example.org
# Contact for the ACME CA (Let's Encrypt). Required.
ACME_EMAIL=ops@example.org
# The web app's origin(s), comma separated: only these may send reports (CORS).
APP_ORIGINS=https://app.example.org

# Secrets: generate each with `openssl rand -hex 32`.
SECRET_KEY=
POSTGRES_PASSWORD=

# How long events (crash reports and bug reports) are kept, in days.
RETENTION_DAYS=30

# Email for password resets and alerts (optional). Example: smtp://user:pass@smtp.example.org:587
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=glitchtip@errors.example.org

# Set to true only while you create the operator account, then back to false.
ENABLE_USER_REGISTRATION=false

# Docker log driver: local (rotated, 3 x 10 MB) or none.
LOG_DRIVER=local
