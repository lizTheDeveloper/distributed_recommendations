# Copy to .env and edit. .env is gitignored.

# Public hostname. DNS must point here before `docker compose up`.
UMAMI_DOMAIN=stats.example.org
# Contact for the ACME CA (Let's Encrypt). Required.
ACME_EMAIL=ops@example.org

# Secrets: generate with `openssl rand -hex 32` (TWO_FACTOR_ENCRYPTION_KEY must be 64 hex characters).
APP_SECRET=
TWO_FACTOR_ENCRYPTION_KEY=
POSTGRES_PASSWORD=

# How long usage events and sessions are kept, in days, and how often the job runs.
RETENTION_DAYS=30
RETENTION_INTERVAL_SECONDS=3600

# Docker log driver: local (rotated, 3 x 10 MB) or none.
LOG_DRIVER=local
