# Copy to .env and edit. No secrets go in this file: keys live in ./secrets/ (chmod 600).

# bunker (NIP-46 remote signer, recommended) or key
LABELER_SIGNER=bunker
# File holding bunker://<signer pubkey>?relay=wss://…&secret=…
LABELER_BUNKER_URL_FILE=/run/labeler-secrets/bunker_url
# Optional: stable NIP-46 client key so the signer app remembers this labeler.
LABELER_BUNKER_CLIENT_KEY_FILE=
# Only with LABELER_SIGNER=key: file holding the labeler nsec / hex key.
LABELER_SECRET_KEY_FILE=

# Default reviewer name for the admin service (CLI users pass --reviewer).
LABELER_REVIEWER=

INTAKE_INTERVAL_MINUTES=15
ADMIN_PORT=8787

# local (rotated, 3 x 10 MB) or none
LOG_DRIVER=local

# Outbound proxy, if your network needs one.
NODE_USE_ENV_PROXY=
HTTPS_PROXY=
