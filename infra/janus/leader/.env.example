# Copy to .env (never commit it). Generate fresh values on THIS host:
#   PGPASSWORD:      openssl rand -base64 24 | tr -d '/+='
#   DATASTORE_KEYS:  openssl rand 16 | basenc --base64url | tr -d '='
# The leader and the other aggregator must never share any of these values.
PGPASSWORD=
DATASTORE_KEYS=
# Public HTTPS name for profile "tls" (docker compose --profile tls up -d)
LEADER_DOMAIN=
ACME_EMAIL=
# Local port the aggregator listens on (behind your TLS proxy)
LEADER_BIND=127.0.0.1
LEADER_PORT=9001
# Optional Docker Hub mirror for the postgres image (digest pinned either way)
# DOCKERHUB=mirror.gcr.io
