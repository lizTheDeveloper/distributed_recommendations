# Copy to .env and edit. .env is gitignored (infra/relay/.gitignore).

# The app's working name lives here and only here for the relay.
APP_NAME=Meme Video

# Public hostname. DNS A/AAAA must point at this host before `docker compose up`.
RELAY_DOMAIN=relay.example.org
# For Let's Encrypt expiry notices (optional).
ACME_EMAIL=

# NIP-11 information document.
RELAY_DESCRIPTION=Relay for a federated video app. Stores gift-wrapped (NIP-59) messages until their NIP-40 expiration. No IP logs.
RELAY_CONTACT=mailto:security@example.org
RELAY_ADMIN_PUBKEY=
RELAY_PRIVACY_URL=
RELAY_TERMS_URL=

# NIP-42 AUTH: optional, off by default. See README.md "NIP-42".
RELAY_AUTH=false
# Kinds that need AUTH to read, e.g. 1059. Leave empty with the current web client
# (it authenticates with the identity key only, not with per-match keys).
RELAY_AUTH_RESTRICTED_READ_KINDS=

# Write policy (policy/write-policy.sh).
# Per-IP token bucket: events per second and burst.
POLICY_RATE=2
POLICY_BURST=30
# Forget an IP's bucket after this many idle seconds (memory only, never written).
POLICY_IDLE_FORGET=300
# Max seconds between now and a gift wrap's NIP-40 expiration (31 days).
POLICY_GIFTWRAP_MAX_TTL=2678400
# Empty accepts every kind. A relay only for the app could use:
#   0 = profile, 5 = deletion, 1059 = gift wrap, 10002 = relay list,
#   10050 = DM inbox relays, 34235/34236 = NIP-71 video (bridge)
POLICY_ALLOWED_KINDS=

# Retention backstop for gift wraps (seconds of created_at age) and how often it runs.
GIFTWRAP_RETENTION_SECONDS=2851200
RETENTION_INTERVAL_SECONDS=3600

# Docker log driver: local (rotated, 3 x 10 MB) or none.
LOG_DRIVER=local
