# OHTTP gateway + Nostr target. Copy to .env and edit.

# Public name of the gateway (Caddy gets a certificate for it). The OHTTP relay
# operator points their relay at https://$GATEWAY_SITE/gateway.
GATEWAY_SITE=ohttp-gateway.example.org
ACME_EMAIL=ops@example.org

# 32 random bytes, hex: `openssl rand -hex 32`. Determines the HPKE key, so the
# pin clients ship. Keep it secret; changing it rotates the key.
SEED_SECRET_KEY=
CONFIGURATION_ID=1

# Upstream Nostr relays the target publishes to and queries. Your own relays
# (infra/relay) or relays that agreed to carry this traffic. Never relays that
# rate-limit per IP without an allowance for the gateway: every user shares its IP.
NOSTR_RELAYS=wss://relay.example.org

ALLOWED_KINDS=1059
UPSTREAM_TIMEOUT_MS=5000
# rate/burst. Global, per recipient key (publishes), per #p set (queries).
RATE_GLOBAL=50/200
RATE_RECIPIENT=0.5/60
RATE_QUERY=1/30

LOG_DRIVER=local
