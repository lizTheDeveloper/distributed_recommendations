# The Nostr gateway target (packages/transport/bin/target.ts): the HTTP resource
# behind the OHTTP gateway that speaks NIP-01 to the configured relays.
# Build context: packages/transport (compose.yaml sets it; its .dockerignore keeps
# node_modules and tests out).
#
# Behind a TLS-intercepting proxy, pass its CA as `--secret id=extra_ca,src=...`.

ARG NODE_IMAGE=node:22.22.0-alpine@sha256:e4bf2a82ad0a4037d28035ae71529873c069b13eb0455466ae0bc13363826e34

FROM ${NODE_IMAGE}
ENV NODE_ENV=production
WORKDIR /app
COPY package.json package-lock.json .npmrc ./
# Exact versions from the lockfile, no install scripts (.npmrc), no dev dependencies.
RUN --mount=type=secret,id=extra_ca \
    if [ -s /run/secrets/extra_ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/extra_ca; fi; \
    npm ci --omit=dev --ignore-scripts --no-audit --no-fund && npm cache clean --force
COPY src ./src
COPY bin ./bin
USER node
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s CMD wget -q -O /dev/null http://127.0.0.1:8080/health || exit 1
CMD ["node", "--experimental-strip-types", "--disable-warning=ExperimentalWarning", "bin/target.ts"]
