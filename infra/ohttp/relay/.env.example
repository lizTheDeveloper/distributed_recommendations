# OHTTP relay. Copy to .env and edit. Run by a different operator than the gateway.
RELAY_SITE=ohttp-relay.example.net
ACME_EMAIL=ops@example.net
# The gateway this relay serves (only this one).
GATEWAY_URL=https://ohttp-gateway.example.org
# The web app's origin, for CORS.
CORS_ORIGIN=https://app.example.com
LOG_DRIVER=local
